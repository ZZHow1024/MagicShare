<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="540.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.zzhow.magicshare.ui.controller.MainController">
   <children>
      <Label layoutX="287.0" layoutY="10.0" text="MagicShare">
         <font>
            <Font size="25.0" />
         </font>
      </Label>
      <!-- 服务控制栏（全局）：内网 IPv4 / 端口 / 启动服务 / 连接密码 / 分享模式 / 当前连接数 -->
      <Label fx:id="label1" alignment="CENTER_RIGHT" contentDisplay="RIGHT" layoutX="32.0" layoutY="52.0" prefHeight="16.0" prefWidth="190.0" text="Intranet IPv4 address:" textAlignment="RIGHT" />
      <ChoiceBox fx:id="ipAddressSelector" layoutX="232.0" layoutY="47.0" prefHeight="24.0" prefWidth="235.0" />
      <Label fx:id="label9" alignment="CENTER" contentDisplay="CENTER" layoutX="510.0" layoutY="47.0" prefHeight="16.0" prefWidth="130.0" text="Current number of connections" textAlignment="CENTER" />
      <Label fx:id="label3" alignment="CENTER_RIGHT" contentDisplay="RIGHT" layoutX="32.0" layoutY="86.0" prefHeight="16.0" prefWidth="190.0" text="Port number:" />
      <TextField fx:id="textField1" layoutX="232.0" layoutY="81.0" onKeyPressed="#onStartOrStopServiceKeyDown" prefHeight="24.0" prefWidth="112.0" promptText="1-65535" text="80" />
      <Button fx:id="button1" layoutX="351.0" layoutY="81.0" mnemonicParsing="false" onAction="#onStartOrStopServiceClicked" text="Start service" />
      <Label fx:id="label10" alignment="CENTER" contentDisplay="CENTER" layoutX="543.0" layoutY="78.0" prefHeight="20.0" prefWidth="94.0" text="0" textAlignment="CENTER">
         <font>
            <Font size="20.0" />
         </font>
      </Label>
      <Label fx:id="label8" alignment="CENTER_RIGHT" contentDisplay="RIGHT" layoutX="32.0" layoutY="120.0" prefHeight="17.0" prefWidth="190.0" text="Connection password:" />
      <TextField fx:id="textField3" layoutX="232.0" layoutY="115.0" onKeyPressed="#onStartOrStopServiceKeyDown" prefHeight="24.0" prefWidth="235.0" />
      <CheckBox fx:id="checkBox1" layoutX="475.0" layoutY="120.0" mnemonicParsing="false" onAction="#onEnablePasswordClicked" prefHeight="18.0" prefWidth="170.0" selected="true" text="Enable Password" />
      <Label fx:id="label11" alignment="CENTER_RIGHT" contentDisplay="RIGHT" layoutX="32.0" layoutY="152.0" prefHeight="17.0" prefWidth="190.0" text="Mode:" />
      <Button fx:id="standardShareModeButton" layoutX="232.0" layoutY="147.0" mnemonicParsing="false" onAction="#onStandardShareModeClicked" prefHeight="24.0" prefWidth="117.0" text="Full mode" />
      <Button fx:id="simpleShareModeButton" layoutX="350.0" layoutY="147.0" mnemonicParsing="false" onAction="#onSimpleShareModeClicked" prefHeight="24.0" prefWidth="117.0" text="Simple mode" />
      <!-- 发送 / 接收 分栏 -->
      <TabPane fx:id="tabPane" layoutY="185.0" prefHeight="311.0" prefWidth="700.0" tabClosingPolicy="UNAVAILABLE">
         <tabs>
            <Tab fx:id="tabSend" text="Send" closable="false">
               <content>
                  <AnchorPane onDragDropped="#onDragFile" onDragOver="#handleDragOver">
                     <children>
                        <Label fx:id="label4" alignment="CENTER_RIGHT" contentDisplay="RIGHT" layoutX="32.0" layoutY="15.0" prefHeight="16.0" prefWidth="190.0" text="Shared file/folder:" />
                        <TextField fx:id="textField2" layoutX="232.0" layoutY="10.0" onKeyPressed="#onSearchFileKeyDown" prefHeight="24.0" prefWidth="235.0" />
                        <Button fx:id="button2" layoutX="474.0" layoutY="9.0" mnemonicParsing="false" onAction="#onSelectFileClicked" text="Select folder" />
                        <CheckBox fx:id="showDirectoryStructureCheckBox" layoutX="562.0" layoutY="14.0" mnemonicParsing="false" prefHeight="18.0" prefWidth="145.0" selected="true" text="Show folders" visible="false" />
                        <Label fx:id="label6" alignment="CENTER" contentDisplay="CENTER" layoutX="34.0" layoutY="42.0" prefHeight="16.0" prefWidth="46.0" text="0" textAlignment="CENTER">
                           <font>
                              <Font size="20.0" />
                           </font>
                        </Label>
                        <Label fx:id="label5" layoutX="14.0" layoutY="74.0" text="Number of shared files" />
                        <Label fx:id="label7" alignment="CENTER" contentDisplay="CENTER" layoutX="176.0" layoutY="74.0" prefHeight="17.0" prefWidth="350.0" text="Drag the file/folder to be shared here to get the path" textAlignment="CENTER" textOverrun="CENTER_ELLIPSIS" />
                        <Button fx:id="button3" alignment="CENTER_RIGHT" contentDisplay="RIGHT" layoutX="555.0" layoutY="70.0" mnemonicParsing="false" onAction="#onClearFileClicked" text="Clear sharing list" textAlignment="RIGHT" />
                        <TableView fx:id="tableView1" layoutY="100.0" prefHeight="205.0" prefWidth="700.0" />
                     </children>
                  </AnchorPane>
               </content>
            </Tab>
            <Tab fx:id="tabReceive" text="Receive" closable="false">
               <content>
                  <AnchorPane>
                     <children>
                        <CheckBox fx:id="allowUploadCheckBox" layoutX="232.0" layoutY="15.0" mnemonicParsing="false" text="Allow receiving files" />
                        <Label fx:id="label12" alignment="CENTER_RIGHT" contentDisplay="RIGHT" layoutX="32.0" layoutY="55.0" prefHeight="16.0" prefWidth="190.0" text="Receive directory:" />
                        <TextField fx:id="receiveDirTextField" editable="false" layoutX="232.0" layoutY="50.0" prefHeight="24.0" prefWidth="240.0" />
                        <Button fx:id="button5" layoutX="480.0" layoutY="50.0" mnemonicParsing="false" onAction="#onSelectReceiveDirClicked" text="Browse" />
                        <TableView fx:id="receiveTableView" layoutY="90.0" prefHeight="185.0" prefWidth="700.0" />
                     </children>
                  </AnchorPane>
               </content>
            </Tab>
         </tabs>
      </TabPane>
      <Button fx:id="button4" layoutX="14.0" layoutY="500.0" mnemonicParsing="false" onAction="#onAboutClicked" text="About" />
      <Label layoutX="526.0" layoutY="505.0" text="Language:" />
      <ChoiceBox fx:id="languageSelector" layoutX="598.0" layoutY="500.0" onAction="#switchLanguage" prefHeight="26.0" prefWidth="88.0" />
      <Label layoutX="329.0" layoutY="505.0" text="ZZHow" />
   </children>
</AnchorPane>
